{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NPDF",
  "version": "0.1.0",
  "identifier": "app.npdf.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "NPDF",
        "width": 1320,
        "height": 880,
        "minWidth": 420,
        "minHeight": 480,
        "resizable": true,
        "dragDropEnabled": true,
        "theme": null,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "PDF-Editor, der lokal arbeitet",
    "longDescription": "NPDF bearbeitet vorhandene PDF-Dateien wirklich, statt sie nur zu ueberlagern. Alles laeuft lokal, ohne Konto und ohne Cloud.",
    "copyright": "Copyright 2026 NPDF contributors",
    "licenseFile": "../LICENSE-MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../vendor/pdfium/lib/*pdfium*": "pdfium/"
    },
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "name": "PDF",
        "description": "Portable Document Format",
        "role": "Editor",
        "mimeType": "application/pdf"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": ["German", "English"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "iOS": {
      "minimumSystemVersion": "13.0"
    },
    "android": {
      "minSdkVersion": 24
    }
  }
}
